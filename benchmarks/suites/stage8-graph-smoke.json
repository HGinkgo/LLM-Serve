{
  "schema_version": 1,
  "name": "stage8-graph-smoke",
  "runs": 1,
  "profiles": {
    "tiny-decode": {
      "classes": [
        {
          "name": "decode",
          "weight": 1,
          "input_len": 32,
          "output_len": 8
        }
      ]
    }
  },
  "experiments": [
    {
      "name": "graph-smoke",
      "arrival": "closed-loop",
      "profile": "tiny-decode",
      "max_concurrencies": [1],
      "warmup_seconds": 1,
      "measurement_seconds": 3,
      "variants": [
        {
          "name": "eagle-graph",
          "enable_speculative": true
        },
        {
          "name": "eagle-eager",
          "enable_speculative": true,
          "enforce_eager": true,
          "enable_speculative_cuda_graph": false
        }
      ],
      "runtime": {
        "enforce_eager": false,
        "argmax_sampler": true,
        "warmup": true,
        "max_model_len": 1024,
        "max_num_batched_tokens": 512,
        "speculative_gamma": 3,
        "speculative_accept_mode": "greedy",
        "enable_speculative_cuda_graph": true
      }
    }
  ]
}
